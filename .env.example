# Copy to .env and replace both password placeholders before starting Compose.
WATCH_ROOT=watched_data
UDP_HOST=127.0.0.1
UDP_PORT=9999
UDP_MAX_PAYLOAD=8192
OBSERVER_MODE=polling
POLL_INTERVAL=1
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=filepulse
POSTGRES_USER=filepulse
POSTGRES_PASSWORD=
MONGO_PASSWORD=
# Compose builds its internal URI from MONGO_PASSWORD; for native execution set this:
MONGO_URI=
MONGO_DATABASE=filepulse
DB_TIMEOUT_SECONDS=3
# Native dashboard execution; Compose uses its internal API service URL.
API_BASE_URL=http://localhost:8000
API_TIMEOUT_SECONDS=30
